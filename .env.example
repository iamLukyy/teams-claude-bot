# Azure Portal → App Registrations → your app
MICROSOFT_APP_ID=your-app-id                # Application (client) ID
MICROSOFT_APP_PASSWORD=your-app-password    # Certificates & secrets → Client Secret Value
MICROSOFT_APP_TENANT_ID=your-tenant-id      # Directory (tenant) ID

# Server
PORT=3978

# Dev tunnel (persistent ID)
DEVTUNNEL_ID=your-tunnel-id

# Claude Code working directory (required, must exist)
CLAUDE_WORK_DIR=~/Work

# Auto-generated by setup (do not edit)
TEAMS_APP_ID=auto-generated-uuid              # Unique Teams app identifier

# ─── Eventuality deployment (server, no dev tunnel) ───
# Tools Claude may use without asking (CSV). Empty = read-only default.
ALLOWED_TOOLS=Bash,Read,Write,Edit,Grep,Glob,LS,Skill,AskUserQuestion,TodoWrite,WebFetch
# Entra object IDs (CSV) allowed to talk to the bot. Empty = anyone (bootstrap only!)
ALLOWED_USERS=
# Teams conversation IDs (CSV) the bot serves. Empty = any (bootstrap only!)
ALLOWED_CONVERSATIONS=
# Close the Claude session after this many hours without messages (0 = never)
SESSION_IDLE_HOURS=12
# Model alias or id for new sessions
DEFAULT_MODEL=opus
# Use the installed Claude Code CLI instead of the SDK-bundled one
CLAUDE_CLI_PATH=/root/.local/bin/claude
# Upstream default was always-on; the CLI refuses it under root. Set to 1 only on a non-root host.
ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=0
