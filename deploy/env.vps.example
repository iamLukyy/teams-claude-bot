# /root/Projects/teams-claude-bot/.env on vps (chmod 600). Fill MICROSOFT_* from Entra/Azure Bot.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
TEAMS_APP_ID=
PORT=3978
CLAUDE_WORK_DIR=/root/Projects/flaskapp-caflou-checker
CLAUDE_CLI_PATH=/root/.local/bin/claude
ALLOWED_TOOLS=Bash,Read,Write,Edit,Grep,Glob,LS,Skill,AskUserQuestion,TodoWrite,WebFetch
ALLOWED_USERS=
ALLOWED_CONVERSATIONS=
SESSION_IDLE_HOURS=12
DEFAULT_MODEL=opus
PERMISSION_MODE=default
